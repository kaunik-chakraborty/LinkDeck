<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_surface_card"
    android:layout_marginBottom="10dp">

    <!-- Top Row: Domain / Rule title + Enable Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/link"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:tint="?attr/colorPrimary"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/textRuleCondition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:ellipsize="middle"
            android:singleLine="true"
            tools:text="youtube.com/shorts/*" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRuleEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Target app indication chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginStart="28dp">

        <TextView
            android:id="@+id/textRuleTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:background="@drawable/bg_badge_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            tools:text="↳ Opens in Brave" />

    </LinearLayout>

    <!-- Bottom Action Row: Edit & Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditRule"
            style="@style/Widget.LinkDeck.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/action_edit"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteRule"
            style="@style/Widget.LinkDeck.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/action_delete"
            android:textSize="13sp"
            android:textColor="@color/error" />

    </LinearLayout>

</LinearLayout>
