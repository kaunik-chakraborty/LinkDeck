<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_url_badge"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp" />

    <!-- Top Header Bar with Title and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/textScanResultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/qr_result_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/btnQrResultClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/btn_done"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Status Badges Container (ChipGroup for auto-wrapping and spacing) -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/layoutBadges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp"
        app:singleLine="false"
        android:layout_marginBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/badgeThreatWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_result_threat_badge"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/error"
            android:background="@drawable/bg_badge_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/badgeDeAmped"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/badge_de_amped"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:background="@drawable/bg_badge_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone"
            tools:visibility="visible" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Scanned Payload Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPayload"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Category / Type Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iconPayloadType"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/link"
                    android:contentDescription="@null"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/textPayloadType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/qr_result_weblink_title"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>

            <!-- Destination URL / Plain Text Content -->
            <TextView
                android:id="@+id/textDestinationUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:lineSpacingExtra="2dp"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:layout_marginTop="8dp"
                android:textIsSelectable="true"
                tools:text="https://en.wikipedia.org/wiki/Kotlin" />

            <!-- De-AMP Source Details (if applicable) -->
            <TextView
                android:id="@+id/textDeAmpSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:lineSpacingExtra="1dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                tools:text="Unwrapped from google.com/amp/..." />

            <!-- Threat Warning Detail (if applicable) -->
            <TextView
                android:id="@+id/textThreatDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/error"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                tools:text="• Domain uses Punycode spoofing" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Web Link Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutWebActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenWithLinkDeck"
            style="@style/Widget.LinkDeck.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/qr_result_btn_open"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/link"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInspectLink"
                style="@style/Widget.LinkDeck.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/qr_result_btn_inspect"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/info"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:cornerRadius="24dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyCleanLink"
                style="@style/Widget.LinkDeck.SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/qr_result_btn_copy"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/copy"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:cornerRadius="24dp"
                android:layout_marginStart="6dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Plaintext Actions (for non-URL payloads) -->
    <LinearLayout
        android:id="@+id/layoutPlainActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyPlainText"
            style="@style/Widget.LinkDeck.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/copy_link_btn"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/copy"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSharePlainText"
            style="@style/Widget.LinkDeck.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_share"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_share_forward"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
