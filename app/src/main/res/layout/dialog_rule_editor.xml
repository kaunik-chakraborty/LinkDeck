<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_url_badge" />

    <!-- Header with Title & Dismiss Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/textEditorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/add_rule_title"
            style="@style/TextAppearance.LinkDeck.ScreenTitle"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnRuleEditorClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/close"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/dismiss_btn"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rules_desc"
        style="@style/TextAppearance.LinkDeck.Supporting"
        android:layout_marginBottom="16dp" />

    <!-- Website Host Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutRuleHost"
        style="@style/Widget.LinkDeck.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/rule_domain_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editRuleHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Path Pattern Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutRulePath"
        style="@style/Widget.LinkDeck.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/rule_path_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editRulePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Target App Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutRuleTarget"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/rule_target_hint">

        <AutoCompleteTextView
            android:id="@+id/autoCompleteRuleTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Error notice -->
    <TextView
        android:id="@+id/textRuleEditorError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        tools:text="Please select a target application" />

    <!-- Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveRule"
        style="@style/Widget.LinkDeck.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/btn_save_rule"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="24dp"
        android:layout_marginTop="18dp" />

</LinearLayout>
