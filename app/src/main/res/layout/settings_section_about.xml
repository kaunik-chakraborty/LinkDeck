<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/TextAppearance.LinkDeck.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/settings_category_about"
        android:textColor="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.LinkDeck.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_version_title" />
        <TextView
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/setting_version_desc" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            style="@style/TextAppearance.LinkDeck.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_license_title" />
        <TextView
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/setting_license_desc" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            style="@style/TextAppearance.LinkDeck.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_privacy_title" />
        <TextView
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/setting_privacy_desc" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Replay Walkthrough Row -->
        <LinearLayout
            android:id="@+id/btnRowWalkthrough"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.LinkDeck.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_walkthrough_title" />
            <TextView
                style="@style/TextAppearance.LinkDeck.Supporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/setting_walkthrough_desc" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- GitHub Repository & Star Row -->
        <LinearLayout
            android:id="@+id/btnRowGithub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_github" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.LinkDeck.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_github_title" />
                <TextView
                    style="@style/TextAppearance.LinkDeck.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/setting_github_desc" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
