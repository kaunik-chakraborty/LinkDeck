<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/TextAppearance.LinkDeck.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/settings_category_appearance"
        android:textColor="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_surface_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Theme Mode Item -->
        <LinearLayout
            android:id="@+id/rowThemeSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.LinkDeck.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App theme" />

                <TextView
                    android:id="@+id/textCurrentTheme"
                    style="@style/TextAppearance.LinkDeck.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    tools:text="System default" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Font Selection Item -->
        <LinearLayout
            android:id="@+id/rowFontSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.LinkDeck.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Typography font" />

                <TextView
                    android:id="@+id/textCurrentFont"
                    style="@style/TextAppearance.LinkDeck.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    tools:text="Satoshi (Contemporary neo-grotesque)" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:id="@+id/dividerDynamicColor"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <!-- Material You Dynamic Color Switch -->
        <LinearLayout
            android:id="@+id/rowDynamicColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.LinkDeck.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Material You dynamic colors" />

                <TextView
                    android:id="@+id/textDynamicColorDesc"
                    style="@style/TextAppearance.LinkDeck.Supporting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Tint app interface using system wallpaper colors (Android 12+)" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDynamicColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
