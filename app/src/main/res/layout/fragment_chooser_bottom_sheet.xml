<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_url_badge" />

    <!-- Focused Link Card -->
    <LinearLayout
        android:id="@+id/urlPreviewBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        android:background="@drawable/bg_surface_card">

        <!-- Top Row: Host title & Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/link"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/textHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="youtube.com" />

            <ImageButton
                android:id="@+id/btnInspectLink"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/info"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/inspector_btn_inspect"
                app:tint="?attr/colorOnSurface"
                android:layout_marginStart="6dp" />

            <ImageButton
                android:id="@+id/btnCopyLink"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/copy"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/copy_link_btn"
                app:tint="?attr/colorOnSurface"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Subtitle Path -->
        <TextView
            android:id="@+id/textPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:textSize="13sp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:layout_marginTop="4dp"
            android:layout_marginStart="28dp"
            tools:text="/watch?v=dQw4w9WgXcQ" />

        <!-- Status Badges: Redirect & Tracking Cleaning -->
        <LinearLayout
            android:id="@+id/layoutBadges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginStart="28dp">

            <TextView
                android:id="@+id/textSecurityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/error"
                android:background="@drawable/bg_badge_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                tools:text="Phishing Risk" />

            <TextView
                android:id="@+id/textCleanedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_cleaned_badge"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:background="@drawable/bg_badge_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textDeAmpedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/badge_de_amped"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:background="@drawable/bg_badge_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textRedirectSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:background="@drawable/bg_badge_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:visibility="gone"
                tools:text="↳ bit.ly" />

        </LinearLayout>

        <!-- Original Link Checkbox Container -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbOpenOriginalLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checkbox_open_original_link"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="6dp"
            android:layout_marginStart="20dp"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginBottom="4dp" />

    <!-- Loading State for In-Flight Redirect Resolution -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checking_destination"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- Targets List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/targetsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- Action Buttons for Just Once / Always -->
    <LinearLayout
        android:id="@+id/actionButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJustOnce"
            style="@style/Widget.LinkDeck.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/action_just_once"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlways"
            style="@style/Widget.LinkDeck.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="@string/action_always"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_targets_title"
            style="@style/TextAppearance.LinkDeck.Section"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_targets_desc"
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/errorStateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_invalid_link_title"
            style="@style/TextAppearance.LinkDeck.Section"
            android:textColor="@color/error" />

        <TextView
            android:id="@+id/textErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissError"
            style="@style/Widget.LinkDeck.SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dismiss_btn"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</LinearLayout>
