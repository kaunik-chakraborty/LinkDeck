<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/TextAppearance.LinkDeck.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/settings_category_diagnostics"
        android:textColor="?attr/colorPrimary" />

    <LinearLayout
        android:id="@+id/btnRowTestLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_surface_card"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            style="@style/TextAppearance.LinkDeck.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_test_link_title" />
        <TextView
            style="@style/TextAppearance.LinkDeck.Supporting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/setting_test_link_desc" />
    </LinearLayout>
</LinearLayout>
