<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/testLinkRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/testLinkToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/android:colorBackground"
        app:title="@string/test_link_screen_title"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_nav_back"
        app:navigationIconTint="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp">

            <!-- Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/test_link_hint"
                        app:endIconMode="clear_text"
                        style="@style/Widget.LinkDeck.TextInputLayout">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTestLinkInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestPaste"
                        style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        app:icon="@drawable/paste"
                        app:iconTint="?attr/colorOnSurface"
                        app:cornerRadius="14dp"
                        android:contentDescription="@string/btn_paste" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRunTest"
                    style="@style/Widget.LinkDeck.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/test_link_btn_inspect"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- Loading Indicator -->
            <LinearLayout
                android:id="@+id/testLoadingLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="16dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminate="true" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/checking_destination"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="12dp" />

            </LinearLayout>

            <!-- Results Card -->
            <LinearLayout
                android:id="@+id/testResultsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Resolution Breakdown Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_link_results_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <!-- Status Badges -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/layoutTestBadges"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTestDeAmped"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="@string/badge_de_amped"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnErrorContainer"
                            app:chipBackgroundColor="?attr/colorErrorContainer"
                            app:chipStrokeColor="@android:color/transparent"
                            android:visibility="gone" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTestCleaned"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            app:chipBackgroundColor="?attr/colorPrimaryContainer"
                            app:chipStrokeColor="@android:color/transparent"
                            android:visibility="gone"
                            tools:text="3 Trackers Removed" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTestRedirects"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            app:chipBackgroundColor="?attr/colorSecondaryContainer"
                            app:chipStrokeColor="@android:color/transparent"
                            tools:text="Direct Link" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- Original Link -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_link_original"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTestOriginal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        tools:text="https://bit.ly/3xyz" />

                    <!-- Redirect Chain -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_link_redirect_chain"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTestRedirects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        tools:text="Direct link (no redirects)" />

                    <!-- Cleaned Destination -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_link_cleaned"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTestCleaned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:textIsSelectable="true"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp"
                        tools:text="https://youtube.com/watch?v=123" />

                    <!-- Routing Rule / Preference -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_link_routing_rule"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTestRoutingRule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"
                        tools:text="Matched custom rule for youtube.com/shorts/*" />

                </LinearLayout>

                <!-- Target Apps Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_surface_card"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/test_link_target_apps"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <!-- Open With Apps (Browsers & Dedicated Handlers) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chooser_title"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupOpenApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Share With Targets -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_share_with"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupShareApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp" />

                </LinearLayout>

                <!-- Action Buttons: Open in Chooser & Show QR Code -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenInChooser"
                        style="@style/Widget.LinkDeck.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/test_link_btn_open"
                        android:textStyle="bold"
                        app:cornerRadius="24dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowQrCode"
                        style="@style/Widget.LinkDeck.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/action_qr_code"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_qr_code"
                        app:cornerRadius="24dp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
