<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_url_badge" />

    <!-- Top Header Bar with Title and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/textInspectorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inspector_title"
            style="@style/TextAppearance.LinkDeck.ScreenTitle"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btnInspectorClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/close"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="@string/btn_done"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Threat Warnings Card (Only visible when threats detected) -->
            <LinearLayout
                android:id="@+id/layoutThreatContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/shieldcheck"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="@color/error"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/textThreatCardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_threats_title"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/error" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutThreatItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- Hero Destination Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/link"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_section_destination"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textInspectorDestinationUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    tools:text="https://youtube.com/watch?v=123" />

            </LinearLayout>

            <!-- Connection Security & Certificate Card -->
            <LinearLayout
                android:id="@+id/cardConnectionSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iconSecurityStatus"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/shieldcheck"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_section_security"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textSecurityTransportStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="8dp"
                    android:text="@string/inspector_tls_secure" />

                <TextView
                    android:id="@+id/textSecurityTransportDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="3dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/inspector_tls_secure_desc" />

                <!-- Action Button to Trigger On-Demand Certificate Inspection -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInspectCertificate"
                    style="@style/Widget.LinkDeck.SecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/inspector_btn_inspect_tls"
                    app:icon="@drawable/shieldcheck"
                    app:iconSize="16dp" />

                <!-- TLS Handshake Progress -->
                <LinearLayout
                    android:id="@+id/layoutTlsProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:indeterminate="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="@string/inspector_tls_inspecting" />
                </LinearLayout>

                <!-- TLS Verification Error View -->
                <TextView
                    android:id="@+id/textTlsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <!-- Expanded Certificate Details Container -->
                <LinearLayout
                    android:id="@+id/layoutCertificateDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Protocol & Cipher Suite -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_tls_protocol"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTlsProtocolCipher"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="2dp"
                        tools:text="TLSv1.3 • TLS_AES_256_GCM_SHA384" />

                    <!-- Issuer -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inspector_tls_issuer"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTlsIssuer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="2dp"
                        tools:text="DigiCert Global Root G2" />

                    <!-- Subject & SANs -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inspector_tls_subject"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTlsSubject"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="2dp"
                        tools:text="github.com" />

                    <!-- Validity & Days Remaining -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inspector_tls_validity"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTlsValidity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="2dp"
                        tools:text="Valid until Mar 15, 2027 (184 days remaining)" />

                    <!-- Public Key Specs -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inspector_tls_keys"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/textTlsPublicKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="2dp"
                        tools:text="RSA (2048 bits) • SHA256withRSA" />

                    <!-- SHA-256 Fingerprint with Copy Button -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/inspector_tls_fingerprint"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/textTlsFingerprint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="8A:6B:C3:4D:99:..." />

                        <ImageButton
                            android:id="@+id/btnCopyFingerprint"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/copy"
                            android:background="@drawable/bg_icon_button"
                            android:contentDescription="@string/inspector_tls_fingerprint"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Original URL Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/link"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_section_original"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textInspectorOriginalUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    tools:text="https://bit.ly/3xyz" />

            </LinearLayout>

            <!-- Redirect Chain Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/redirect"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_section_redirects"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutRedirectHops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textInspectorNoRedirects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inspector_no_redirects"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Tracking Protection Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/shieldcheck"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_section_tracking"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textInspectorTrackingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    tools:text="Removed 2 tracking parameters (utm_source, fbclid)" />

            </LinearLayout>

            <!-- Routing Decision Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_surface_card"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/settings"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        app:tint="?attr/colorPrimary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inspector_section_routing"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/textInspectorRoutingReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.15"
                    tools:text="Matched custom rule for youtube.com/shorts/*" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInspectorOpenOriginal"
            style="@style/Widget.LinkDeck.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/action_open_original_link"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInspectorDone"
            style="@style/Widget.LinkDeck.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/btn_done" />

    </LinearLayout>

</LinearLayout>
