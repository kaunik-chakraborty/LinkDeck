<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetSettingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/widgetSettingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/android:colorBackground"
        app:title="Widget Quick Links"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_nav_back"
        app:navigationIconTint="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- Add Quick Link Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_surface_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Quick Link to Widget"
                    style="@style/TextAppearance.LinkDeck.Section"
                    android:textSize="17sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add your favorite websites or URLs to access them directly with 1 tap from your home screen widget."
                    style="@style/TextAppearance.LinkDeck.Supporting"
                    android:layout_marginBottom="14dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutWidgetUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Website URL (e.g. youtube.com)"
                    style="@style/Widget.LinkDeck.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editWidgetUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutWidgetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Display name (optional)"
                    style="@style/Widget.LinkDeck.TextInputLayout"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editWidgetTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteClipboard"
                        style="@style/Widget.LinkDeck.SecondaryButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Paste Clipboard"
                        android:textStyle="bold"
                        app:cornerRadius="24dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddQuickLink"
                        style="@style/Widget.LinkDeck.PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Add to Widget"
                        android:textStyle="bold"
                        app:cornerRadius="24dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Saved Links Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configured Widget Links"
                style="@style/TextAppearance.LinkDeck.Section"
                android:textSize="17sp"
                android:layout_marginBottom="8dp" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyQuickLinksLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_surface_card"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Quick Links added yet"
                    style="@style/TextAppearance.LinkDeck.Section"
                    android:textSize="15sp"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use the form above to add your custom links. They will immediately appear on your home screen widget."
                    style="@style/TextAppearance.LinkDeck.Supporting"
                    android:gravity="center"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Recycler List of Quick Links -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerQuickLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
