    <style name="ThemeOverlay.LinkDeck.Font.System" parent="">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="ThemeOverlay.LinkDeck.Font.Satoshi" parent="">
        <item name="fontFamily">@font/font_satoshi</item>
        <item name="android:fontFamily">@font/font_satoshi</item>
