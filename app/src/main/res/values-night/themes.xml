    <style name="ThemeOverlay.LinkDeck.Font.Outfit" parent="">
        <item name="fontFamily">@font/font_outfit</item>
        <item name="android:fontFamily">@font/font_outfit</item>
    </style>

    <style name="ThemeOverlay.LinkDeck.Font.GeneralSans" parent="">
        <item name="fontFamily">@font/font_general_sans</item>
        <item name="android:fontFamily">@font/font_general_sans</item>
    </style>

    <style name="ThemeOverlay.LinkDeck.Font.CabinetGrotesk" parent="">
        <item name="fontFamily">@font/font_cabinet_grotesk</item>
        <item name="android:fontFamily">@font/font_cabinet_grotesk</item>
    </style>

    <style name="ThemeOverlay.LinkDeck.Font.SpaceGrotesk" parent="">
        <item name="fontFamily">@font/font_space_grotesk</item>
