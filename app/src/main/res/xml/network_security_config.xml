<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permits on-device HTTP redirect resolution for user-supplied links while enforcing system certificates -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
